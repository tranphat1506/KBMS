-- Tạo một cơ sở tri thức mới cho bệnh viện
CREATE KNOWLEDGE BASE HospitalDemo DESCRIPTION 'Hệ tri thức Bệnh viện Demo';
USE HospitalDemo;

-- 2. Định nghĩa Khái niệm (Concept) với các Ràng buộc (Constraints)
-- Khái niệm Patient (Bệnh nhân) với các biến và kiểm tra tính hợp lệ dữ liệu
CREATE CONCEPT Patient (
    VARIABLES (
        patientId: STRING,
        name: STRING,
        age: INT,
        sys: DECIMAL, -- Huyết áp tâm thu
        dia: DECIMAL, -- Huyết áp tâm trương
        bmi: DECIMAL,
        riskLevel: STRING -- Mức độ rủi ro (sẽ được suy diễn)
    ),
    CONSTRAINTS (
        age >= 0 AND age <= 150, -- Tuổi phải hợp lệ
        sys > 0 AND dia > 0,
        sys > dia -- Huyết áp tâm thu phải lớn hơn tâm trương
    )
);

-- 3. Giải phương trình và Suy diễn toán học (Symbolic Reasoning)
-- Khái niệm Triangle (Tam giác) minh họa khả năng giải phương trình tự động
CREATE CONCEPT Triangle (
    VARIABLES (
        a: DECIMAL,
        b: DECIMAL,
        c: DECIMAL,
        perimeter: DECIMAL,
        area: DECIMAL
    ),
    EQUATIONS (
        'perimeter = a + b + c', -- Công thức chu vi
        'area = Sqrt(perimeter/2 * (perimeter/2 - a) * (perimeter/2 - b) * (perimeter/2 - c))' -- Công thức Heron
    ),
    CONSTRAINTS (
        a + b > c,
        b + c > a,
        a + c > b
    )
);

-- 4. Trình diễn Giải phương trình Thuận (Forward Solving)
-- Nhập 3 cạnh, hệ thống sẽ tự tính Chu vi và Diện tích
INSERT INTO Triangle VARIABLES (a: 3, b: 4, c: 5);
SELECT a, b, c, SOLVE(perimeter), SOLVE(area) FROM Triangle;

-- 5. Trình diễn Giải phương trình Ngược (Backward Solving / Reverse Reasoning)
-- Nhập 2 cạnh và Chu vi, hệ thống sẽ tự suy diễn ra cạnh còn lại (c)
INSERT INTO Triangle VARIABLES (a: 6, b: 8, perimeter: 24);
SELECT a, b, perimeter, SOLVE(c) FROM Triangle;

-- 6. Suy diễn Luật (Rules) và Hỗ trợ Alias (Định danh)
-- Tạo quy tắc đánh giá rủi ro dựa trên chỉ số huyết áp
-- Sử dụng định danh 'p' cho Patient để viết luật ngắn gọn
CREATE RULE Rule_HighSys
SCOPE Patient p
IF p.sys > 140
THEN p.riskLevel = 'High';

-- Thêm bệnh nhân mới và yêu cầu hệ thống suy diễn mức độ rủi ro
INSERT INTO Patient VARIABLES (patientId: 'P001', name: 'John Doe', age: 45, sys: 150, dia: 95);
SELECT name, sys, SOLVE(riskLevel) FROM Patient;

-- 7. Cấu trúc Phân cấp và Kế thừa (Hierarchy & Inheritance)
-- Tạo khái niệm SpecialistPatient kế thừa toàn bộ thuộc tính từ Patient
CREATE CONCEPT SpecialistPatient (
    BASE_OBJECTS (Patient),
    VARIABLES (
        specialistName: STRING -- Tên bác sĩ chuyên khoa
    )
);

-- Nhập liệu cho bệnh nhân chuyên khoa (sử dụng được cả biến của lớp cha)
INSERT INTO SpecialistPatient VARIABLES (patientId: 'P002', name: 'Jane Smith', sys: 120, dia: 80, specialistName: 'Dr. Brown');
SELECT name, sys, specialistName FROM SpecialistPatient;

-- 8. Quản trị và Hiệu năng (Maintenance)
-- Thực hiện tái lập chỉ mục để tối ưu hóa truy vấn
MAINTENANCE (REINDEX (HospitalDemo));

-- Kiểm tra lại danh sách bệnh nhân sau khi xử lý
SELECT patientId, name, sys, SOLVE(riskLevel) FROM Patient;

-- Kết thúc demo
-- EXIT;
