LOGIN root root;
-- KBMS Comprehensive Test Suite: HEALTHCARE (FINAL)
CREATE KNOWLEDGE BASE Healthcare; USE Healthcare;
CREATE CONCEPT PatientRisk ( VARIABLES ( pId: STRING, age: INT, bmi: DECIMAL, glucose: DECIMAL, riskLevel: STRING ) );
CREATE RULE Rule_Diabetes_High SCOPE PatientRisk IF age > 45 AND glucose > 126 AND bmi > 30 THEN riskLevel = 'High Risk';
CREATE CONCEPT MedInteraction ( VARIABLES ( drugA: STRING, drugB: STRING, interaction: STRING ) );
CREATE RULE Rule_Inter_Warfarin_Aspirin SCOPE MedInteraction IF drugA = 'Warfarin' AND drugB = 'Aspirin' THEN interaction = 'Danger: Bleeding Risk';
CREATE CONCEPT Triage ( VARIABLES ( patientName: STRING, heartRate: INT, spO2: INT, priority: STRING ) );
CREATE RULE Rule_Triage_Urgent SCOPE Triage IF heartRate > 120 OR spO2 < 90 THEN priority = 'URGENT';
CREATE CONCEPT Cell ( VARIABLES ( dnaSequence: STRING, mutationDetected: BOOL ) );
CREATE CONCEPT CancerCell ( BASE_OBJECTS (Cell), VARIABLES ( growthRate: DECIMAL, stage: INT ) );
CREATE CONCEPT Dosage ( VARIABLES ( weight: DECIMAL, conc: DECIMAL, freq: DECIMAL, dose: DECIMAL ) );
CREATE RULE Rule_Calc_Dose SCOPE Dosage THEN dose = weight * conc / freq;
CREATE CONCEPT Insurance ( VARIABLES ( age: INT, preExisting: BOOL, eligible: BOOL ) );
CREATE RULE Rule_Insur_Check SCOPE Insurance IF age < 65 AND preExisting = false THEN eligible = true;
CREATE CONCEPT ProstateBiopsy ( VARIABLES ( primaryGrade: INT, secondaryGrade: INT, totalScore: INT ) );
CREATE RULE Rule_Gleason_Sum SCOPE ProstateBiopsy THEN totalScore = primaryGrade + secondaryGrade;
CREATE CONCEPT Virus ( VARIABLES ( contacts: INT, duration: DECIMAL, r0: DECIMAL ) );
CREATE RULE Rule_R0_Calc SCOPE Virus THEN r0 = contacts * duration * 0.1;
CREATE CONCEPT PHQ9 ( VARIABLES ( q1: INT, q2: INT, q3: INT, totalScore: INT, severity: STRING ) );
CREATE RULE Rule_PHQ9_Sum SCOPE PHQ9 THEN totalScore = q1 + q2 + q3;
CREATE CONCEPT Rehab ( VARIABLES ( startRange: DECIMAL, currentRange: DECIMAL, progress: DECIMAL ) );
CREATE RULE Rule_Rehab_Perc SCOPE Rehab THEN progress = (currentRange / startRange) * 100;
INSERT INTO PatientRisk VARIABLES (pId: 'P001', age: 50, bmi: 32, glucose: 140);
INSERT INTO MedInteraction VARIABLES (drugA: 'Warfarin', drugB: 'Aspirin');
INSERT INTO Triage VARIABLES (patientName: 'An', heartRate: 130, spO2: 88);
INSERT INTO Dosage VARIABLES (weight: 70, conc: 0.5, freq: 3);
SELECT pId, SOLVE(riskLevel) FROM PatientRisk; SELECT drugA, drugB, SOLVE(interaction) FROM MedInteraction; SELECT patientName, SOLVE(priority) FROM Triage; SELECT weight, SOLVE(dose) FROM Dosage;
-- KBMS Comprehensive Test Suite: FINANCE (FINAL)
CREATE KNOWLEDGE BASE Finance; USE Finance;
CREATE CONCEPT LoanApp ( VARIABLES ( applicant: STRING, creditScore: INT, dti: DECIMAL, statusVal: STRING ) );
CREATE RULE Rule_Loan_Approve SCOPE LoanApp IF creditScore > 700 AND dti < 0.35 THEN statusVal = 'APPROVED';
CREATE CONCEPT TaxPayer ( VARIABLES ( income: DECIMAL, taxDue: DECIMAL ) );
CREATE RULE Rule_Tax_High SCOPE TaxPayer IF income > 100000 THEN taxDue = income * 0.3;
CREATE CONCEPT Investment ( VARIABLES ( principal: DECIMAL, rate: DECIMAL, years: DECIMAL, futureValue: DECIMAL ) );
CREATE RULE Rule_Interest_Calc SCOPE Investment THEN futureValue = principal * (1 + rate);
CREATE CONCEPT TxRecord ( VARIABLES ( txId: STRING, amountVal: DECIMAL, velocity: INT, isFraud: BOOL ) );
CREATE RULE Rule_Fraud_Flag SCOPE TxRecord IF amountVal > 5000 AND velocity > 10 THEN isFraud = true;
CREATE CONCEPT AssetRisk ( VARIABLES ( unitPrice: DECIMAL, volatility: DECIMAL, var: DECIMAL ) );
CREATE RULE Rule_VaR_Calc SCOPE AssetRisk THEN var = unitPrice * volatility * 1.65;
CREATE CONCEPT Mortgage ( VARIABLES ( loanAmount: DECIMAL, term: INT, monthlyPayment: DECIMAL ) );
CREATE RULE Rule_Mortgage_Calc SCOPE Mortgage THEN monthlyPayment = loanAmount / term;
CREATE CONCEPT FXPosition ( VARIABLES ( currency: STRING, amountVal: DECIMAL, rate: DECIMAL, usdValue: DECIMAL ) );
CREATE RULE Rule_FX_USD SCOPE FXPosition THEN usdValue = amountVal * rate;
CREATE CONCEPT Stock ( VARIABLES ( ticker: STRING, profit: DECIMAL, payoutRatio: DECIMAL, dividend: DECIMAL ) );
CREATE RULE Rule_Div_Calc SCOPE Stock THEN dividend = profit * payoutRatio;
CREATE CONCEPT Customer ( VARIABLES ( name: STRING, idExpiry: INT, docType: STRING, isCompliant: BOOL ) );
CREATE RULE Rule_KYC_Check SCOPE Customer IF idExpiry > 2026 AND docType = 'Passport' THEN isCompliant = true;
CREATE CONCEPT Arbitrage ( VARIABLES ( binancePrice: DECIMAL, coinbasePrice: DECIMAL, gap: DECIMAL ) );
CREATE RULE Rule_Arb_Gap SCOPE Arbitrage THEN gap = coinbasePrice - binancePrice;
INSERT INTO LoanApp VARIABLES (applicant: 'Binh', creditScore: 750, dti: 0.2);
INSERT INTO TaxPayer VARIABLES (income: 150000);
INSERT INTO Customer VARIABLES (name: 'Charlie', idExpiry: 2028, docType: 'Passport');
SELECT applicant, SOLVE(statusVal) FROM LoanApp; SELECT income, SOLVE(taxDue) FROM TaxPayer; SELECT name, SOLVE(isCompliant) FROM Customer;
-- KBMS Comprehensive Test Suite: MANUFACTURING (FINAL)
CREATE KNOWLEDGE BASE Manufacturing; USE Manufacturing;
CREATE CONCEPT Machine ( VARIABLES ( mId: STRING, vibration: DECIMAL, temp: DECIMAL, needsMaintenance: BOOL ) );
CREATE RULE Rule_Maint_Check SCOPE Machine IF vibration > 5.5 AND temp > 80 THEN needsMaintenance = true;
CREATE CONCEPT ProductionLine ( VARIABLES ( lineId: STRING, avail: DECIMAL, perf: DECIMAL, qual: DECIMAL, oee: DECIMAL ) );
CREATE RULE Rule_OEE_Calc SCOPE ProductionLine THEN oee = avail * perf * qual;
CREATE CONCEPT Component ( VARIABLES ( name: STRING, unitCost: DECIMAL, quantity: INT, totalCost: DECIMAL ) );
CREATE RULE Rule_BOM_Sum SCOPE Component THEN totalCost = unitCost * quantity;
CREATE CONCEPT Shipment ( VARIABLES ( sId: STRING, originalETA: INT, delayDays: INT, newETA: INT ) );
CREATE RULE Rule_Delay_Calc SCOPE Shipment THEN newETA = originalETA + delayDays;
CREATE CONCEPT Sensor ( VARIABLES ( sId: STRING, voltage: DECIMAL, current: DECIMAL, power: DECIMAL ) );
CREATE RULE Rule_Power_Calc SCOPE Sensor THEN power = voltage * current;
CREATE CONCEPT QualityControl ( VARIABLES ( batchId: STRING, defects: INT, totalCount: INT, rate: DECIMAL ) );
CREATE RULE Rule_Defect_Perc SCOPE QualityControl THEN rate = (defects / totalCount) * 100;
CREATE CONCEPT Joint ( VARIABLES ( jId: STRING, targetX: DECIMAL, currentX: DECIMAL, error: DECIMAL ) );
CREATE RULE Rule_Joint_Error SCOPE Joint THEN error = targetX - currentX;
CREATE CONCEPT Rack ( VARIABLES ( rId: STRING, accessFreq: INT, priorityZone: STRING ) );
CREATE RULE Rule_Zone_High SCOPE Rack IF accessFreq > 100 THEN priorityZone = 'HOT';
CREATE CONCEPT BaseBatch ( VARIABLES ( batchNo: STRING, origin: STRING ) );
CREATE CONCEPT UnitBatch ( BASE_OBJECTS (BaseBatch), VARIABLES ( unitId: STRING, statusVal: STRING ) );
CREATE CONCEPT Worker ( VARIABLES ( name: STRING, hasHelmet: BOOL, hasVest: BOOL, isSafe: BOOL ) );
CREATE RULE Rule_Safety_Check SCOPE Worker IF hasHelmet = true AND hasVest = true THEN isSafe = true;
INSERT INTO Machine VARIABLES (mId: 'M101', vibration: 6.2, temp: 85);
INSERT INTO ProductionLine VARIABLES (lineId: 'LINE_A', avail: 0.9, perf: 0.85, qual: 0.98);
INSERT INTO Worker VARIABLES (name: 'Dung', hasHelmet: true, hasVest: true);
SELECT mId, SOLVE(needsMaintenance) FROM Machine; SELECT lineId, SOLVE(oee) FROM ProductionLine; SELECT name, SOLVE(isSafe) FROM Worker;
-- KBMS Comprehensive Test Suite: RETAIL (FINAL)
CREATE KNOWLEDGE BASE Retail; USE Retail;
CREATE CONCEPT Product ( VARIABLES ( pId: STRING, unitCost: DECIMAL, demand: DECIMAL, price: DECIMAL ) );
CREATE RULE Rule_Price_Dynamic SCOPE Product THEN price = unitCost * (1 + (demand * 0.1));
CREATE CONCEPT CustomerLoyalty ( VARIABLES ( cId: STRING, totalSpend: DECIMAL, tier: STRING ) );
CREATE RULE Rule_Tier_Gold SCOPE CustomerLoyalty IF totalSpend > 5000 THEN tier = 'GOLD';
CREATE CONCEPT StockItem ( VARIABLES ( pId: STRING, stockLevel: INT, salesRate: DECIMAL, daysToEmpty: DECIMAL ) );
CREATE RULE Rule_Stock_Empty SCOPE StockItem THEN daysToEmpty = stockLevel / salesRate;
CREATE CONCEPT Package ( VARIABLES ( weight: DECIMAL, zone: INT, shippingCost: DECIMAL ) );
CREATE RULE Rule_Ship_Cost SCOPE Package THEN shippingCost = (weight * 2) + (zone * 5);
CREATE CONCEPT OrderItem ( VARIABLES ( orderId: STRING, item: STRING, suggestion: STRING ) );
CREATE RULE Rule_Suggest_Filter SCOPE OrderItem IF item = 'Coffee' THEN suggestion = 'Paper Filters';
CREATE CONCEPT RefundRequest ( VARIABLES ( daysSincePurchase: INT, isEligible: BOOL ) );
CREATE RULE Rule_Refund_Check SCOPE RefundRequest IF daysSincePurchase < 30 THEN isEligible = true;
CREATE CONCEPT Checkout ( VARIABLES ( subtotalAmount: DECIMAL, couponDisc: DECIMAL, memberDisc: DECIMAL, finalPrice: DECIMAL ) );
CREATE RULE Rule_Final_Price SCOPE Checkout THEN finalPrice = subtotalAmount * (1 - couponDisc) * (1 - memberDisc);
CREATE CONCEPT Review ( VARIABLES ( contentStr: STRING, sentiment: STRING ) );
CREATE RULE Rule_Sent_Positive SCOPE Review IF contentStr = 'Great' OR contentStr = 'Excellent' THEN sentiment = 'POSITIVE';
CREATE CONCEPT SalesForecast ( VARIABLES ( periodMonth: INT, prevMonthSales: DECIMAL, forecast: DECIMAL ) );
CREATE RULE Rule_Fore_Calc SCOPE SalesForecast THEN forecast = prevMonthSales * 1.05;
CREATE CONCEPT Basket ( VARIABLES ( bId: STRING, hasMilk: BOOL, hasBread: BOOL, commonPair: BOOL ) );
CREATE RULE Rule_Basket_Pair SCOPE Basket IF hasMilk = true AND hasBread = true THEN commonPair = true;
INSERT INTO Product VARIABLES (pId: 'SKU01', unitCost: 100, demand: 5);
INSERT INTO CustomerLoyalty VARIABLES (cId: 'C101', totalSpend: 6000);
INSERT INTO Checkout VARIABLES (subtotalAmount: 1000, couponDisc: 0.1, memberDisc: 0.05);
SELECT pId, SOLVE(price) FROM Product; SELECT cId, SOLVE(tier) FROM CustomerLoyalty; SELECT subtotalAmount, SOLVE(finalPrice) FROM Checkout;
-- KBMS Comprehensive Test Suite: SMARTCITY (FINAL)
CREATE KNOWLEDGE BASE SmartCity; USE SmartCity;
CREATE CONCEPT TrafficLight ( VARIABLES ( intersectionId: STRING, carCount: INT, greenDuration: INT ) );
CREATE RULE Rule_Traffic_Time SCOPE TrafficLight THEN greenDuration = 20 + (carCount * 2);
CREATE CONCEPT Bin ( VARIABLES ( bId: STRING, fillLevel: DECIMAL, needsPickup: BOOL ) );
CREATE RULE Rule_Waste_Pickup SCOPE Bin IF fillLevel > 85 THEN needsPickup = true;
CREATE CONCEPT AirQuality ( VARIABLES ( zoneId: STRING, co2: DECIMAL, pm25: DECIMAL, statusVal: STRING ) );
CREATE RULE Rule_AQI_Poor SCOPE AirQuality IF co2 > 1000 OR pm25 > 50 THEN statusVal = 'POOR';
CREATE CONCEPT StreetLight ( VARIABLES ( sId: STRING, ambient: DECIMAL, hasMotion: BOOL, intensity: DECIMAL ) );
CREATE RULE Rule_Light_Full SCOPE StreetLight IF ambient < 20 AND hasMotion = true THEN intensity = 100;
CREATE CONCEPT GridNode ( VARIABLES ( nodeId: STRING, demand: DECIMAL, supply: DECIMAL, statusVal: STRING ) );
CREATE RULE Rule_Grid_Overload SCOPE GridNode IF demand > supply THEN statusVal = 'OVERLOAD';
CREATE CONCEPT WaterPipe ( VARIABLES ( pId: STRING, meterIn: DECIMAL, meterOut: DECIMAL, loss: DECIMAL ) );
CREATE RULE Rule_Pipe_Loss SCOPE WaterPipe THEN loss = meterIn - meterOut;
CREATE CONCEPT ParkingLot ( VARIABLES ( lotId: STRING, totalCount: INT, occupied: INT, available: INT ) );
CREATE RULE Rule_Park_Calc SCOPE ParkingLot THEN available = totalCount - occupied;
CREATE CONCEPT NoiseSensor ( VARIABLES ( sId: STRING, dbLevel: DECIMAL, isNoisy: BOOL ) );
CREATE RULE Rule_Noise_Limit SCOPE NoiseSensor IF dbLevel > 75 THEN isNoisy = true;
CREATE CONCEPT EmergencyUnit ( VARIABLES ( unitId: STRING, categoryType: STRING, isAvailable: BOOL ) );
CREATE CONCEPT BusRoute ( VARIABLES ( routeId: STRING, scheduleTime: INT, delay: INT, actualTime: INT ) );
CREATE RULE Rule_Bus_Actual SCOPE BusRoute THEN actualTime = scheduleTime + delay;
INSERT INTO TrafficLight VARIABLES (intersectionId: 'INT01', carCount: 15);
INSERT INTO Bin VARIABLES (bId: 'BIN101', fillLevel: 90);
INSERT INTO AirQuality VARIABLES (zoneId: 'DOWNTOWN', co2: 1200, pm25: 30);
SELECT intersectionId, SOLVE(greenDuration) FROM TrafficLight; SELECT bId, SOLVE(needsPickup) FROM Bin; SELECT zoneId, SOLVE(statusVal) FROM AirQuality;
-- KBMS Comprehensive Test Suite: ENGINEERING (FINAL)
CREATE KNOWLEDGE BASE Engineering; USE Engineering;
CREATE CONCEPT Bridge ( VARIABLES ( bId: STRING, forceVal: DECIMAL, areaVal: DECIMAL, stress: DECIMAL ) );
CREATE RULE Rule_Bridge_Stress SCOPE Bridge THEN stress = forceVal / areaVal;
CREATE CONCEPT CircuitComponent ( VARIABLES ( cId: STRING, voltage: DECIMAL, current: DECIMAL, resistance: DECIMAL ) );
CREATE RULE Rule_Ohms_Law SCOPE CircuitComponent THEN voltage = current * resistance;
CREATE CONCEPT Room ( VARIABLES ( rId: STRING, volume: DECIMAL, requiredBTU: DECIMAL ) );
CREATE RULE Rule_HVAC_Calc SCOPE Room THEN requiredBTU = volume * 20;
CREATE CONCEPT ConcreteMix ( VARIABLES ( batchId: STRING, cement: DECIMAL, sand: DECIMAL, gravel: DECIMAL, water: DECIMAL, totalWeight: DECIMAL ) );
CREATE RULE Rule_Mix_Total SCOPE ConcreteMix THEN totalWeight = cement + sand + gravel + water;
CREATE CONCEPT Material ( VARIABLES ( mId: STRING, alpha: DECIMAL, length: DECIMAL, tempDelta: DECIMAL, expansion: DECIMAL ) );
CREATE RULE Rule_Therm_Exp SCOPE Material THEN expansion = alpha * length * tempDelta;
CREATE CONCEPT Pipe ( VARIABLES ( pId: STRING, velocity: DECIMAL, areaVal: DECIMAL, flowRate: DECIMAL ) );
CREATE RULE Rule_Flow_Calc SCOPE Pipe THEN flowRate = velocity * areaVal;
CREATE CONCEPT Soil ( VARIABLES ( sId: STRING, cohesion: DECIMAL, friction: DECIMAL, stabilityIndex: DECIMAL ) );
CREATE RULE Rule_Soil_Stable SCOPE Soil THEN stabilityIndex = cohesion + friction;
CREATE CONCEPT Building ( VARIABLES ( name: STRING, height: DECIMAL, sunAngle: DECIMAL, shadowLen: DECIMAL ) );
CREATE RULE Rule_Shadow_Calc SCOPE Building THEN shadowLen = height / (sunAngle * 0.017);
CREATE CONCEPT Tower ( VARIABLES ( tId: STRING, windSpeed: DECIMAL, pressure: DECIMAL ) );
CREATE RULE Rule_Wind_Load SCOPE Tower THEN pressure = 0.5 * 1.225 * (windSpeed * windSpeed);
CREATE CONCEPT WorkTask ( VARIABLES ( tId: STRING, start: INT, duration: INT, finish: INT ) );
CREATE RULE Rule_Task_End SCOPE WorkTask THEN finish = start + duration;
INSERT INTO Bridge VARIABLES (bId: 'BR01', forceVal: 50000, areaVal: 10);
INSERT INTO CircuitComponent VARIABLES (cId: 'R1', current: 2, resistance: 50);
INSERT INTO Room VARIABLES (rId: 'HALL_A', volume: 500);
SELECT bId, SOLVE(stress) FROM Bridge; SELECT cId, SOLVE(voltage) FROM CircuitComponent; SELECT rId, SOLVE(requiredBTU) FROM Room;
-- KBMS Comprehensive Test Suite: EDUCATION (FINAL)
CREATE KNOWLEDGE BASE Education; USE Education;
CREATE CONCEPT StudentGrade ( VARIABLES ( sId: STRING, math: DECIMAL, eng: DECIMAL, sci: DECIMAL, gpa: DECIMAL ) );
CREATE RULE Rule_GPA_Avg SCOPE StudentGrade THEN gpa = (math + eng + sci) / 3;
CREATE CONCEPT Profile ( VARIABLES ( name: STRING, degree: STRING, skill: STRING, recommendation: STRING ) );
CREATE RULE Rule_Career_Dev SCOPE Profile IF degree = 'CS' AND skill = 'Python' THEN recommendation = 'Software Engineer';
CREATE CONCEPT Employee ( VARIABLES ( name: STRING, gross: DECIMAL, taxRate: DECIMAL, net: DECIMAL ) );
CREATE RULE Rule_Pay_Net SCOPE Employee THEN net = gross * (1 - taxRate);
CREATE CONCEPT Attendance ( VARIABLES ( sId: STRING, totalDays: INT, presentDays: INT, perc: DECIMAL ) );
CREATE RULE Rule_Att_Perc SCOPE Attendance THEN perc = (presentDays / totalDays) * 100;
CREATE CONCEPT Scholarship ( VARIABLES ( sId: STRING, gpa: DECIMAL, incomeVal: DECIMAL, isEligible: BOOL ) );
CREATE RULE Rule_Schol_Check SCOPE Scholarship IF gpa > 3.8 AND incomeVal < 20000 THEN isEligible = true;
CREATE CONCEPT SkillGap ( VARIABLES ( name: STRING, required: INT, actual: INT, gap: INT ) );
CREATE RULE Rule_Gap_Calc SCOPE SkillGap THEN gap = required - actual;
CREATE CONCEPT Teacher ( VARIABLES ( name: STRING, class1Hours: INT, class2Hours: INT, totalHours: INT ) );
CREATE RULE Rule_Work_Sum SCOPE Teacher THEN totalHours = class1Hours + class2Hours;
CREATE CONCEPT Course ( VARIABLES ( cId: STRING, modules: INT, completed: INT, progress: DECIMAL ) );
CREATE RULE Rule_Course_Prog SCOPE Course THEN progress = (completed / modules) * 100;
CREATE CONCEPT HRStats ( VARIABLES ( periodYear: INT, departures: INT, totalEmp: INT, turnoverRate: DECIMAL ) );
CREATE RULE Rule_Turnover_Calc SCOPE HRStats THEN turnoverRate = (departures / totalEmp) * 100;
CREATE CONCEPT Funnel ( VARIABLES ( stage: STRING, applicants: INT, passed: INT, convRate: DECIMAL ) );
CREATE RULE Rule_Conv_Calc SCOPE Funnel THEN convRate = (passed / applicants) * 100;
INSERT INTO StudentGrade VARIABLES (sId: 'STU01', math: 4.0, eng: 3.5, sci: 3.8);
INSERT INTO Profile VARIABLES (name: 'Alice', degree: 'CS', skill: 'Python');
INSERT INTO Attendance VARIABLES (sId: 'STU01', totalDays: 100, presentDays: 95);
SELECT sId, SOLVE(gpa) FROM StudentGrade; SELECT name, SOLVE(recommendation) FROM Profile; SELECT sId, SOLVE(perc) FROM Attendance;
-- KBMS Comprehensive Test Suite: AGRICULTURE (FINAL)
CREATE KNOWLEDGE BASE Agriculture; USE Agriculture;
CREATE CONCEPT Field ( VARIABLES ( fId: STRING, evapo: DECIMAL, rain: DECIMAL, waterNeed: DECIMAL ) );
CREATE RULE Rule_Water_Need SCOPE Field THEN waterNeed = evapo - rain;
CREATE CONCEPT Crop ( VARIABLES ( name: STRING, seeds: INT, germRate: DECIMAL, areaVal: DECIMAL, expectedYield: DECIMAL ) );
CREATE RULE Rule_Yield_Calc SCOPE Crop THEN expectedYield = seeds * germRate * areaVal;
CREATE CONCEPT PestStatus ( VARIABLES ( fId: STRING, bugCount: INT, threshold: INT, needsSpray: BOOL ) );
CREATE RULE Rule_Pest_Spray SCOPE PestStatus IF bugCount > threshold THEN needsSpray = true;
CREATE CONCEPT SoilSample ( VARIABLES ( sId: STRING, n: DECIMAL, p: DECIMAL, k: DECIMAL, totalNPK: DECIMAL ) );
CREATE RULE Rule_NPK_Sum SCOPE SoilSample THEN totalNPK = n + p + k;
CREATE CONCEPT Feed ( VARIABLES ( animalId: STRING, weight: DECIMAL, proteinPerc: DECIMAL, proteinGrams: DECIMAL ) );
CREATE RULE Rule_Feed_Prot SCOPE Feed THEN proteinGrams = weight * proteinPerc;
CREATE CONCEPT Greenhouse ( VARIABLES ( gId: STRING, temp: DECIMAL, ventStatus: STRING, humidity: DECIMAL ) );
CREATE RULE Rule_GH_Humid SCOPE Greenhouse IF temp > 35 THEN ventStatus = 'OPEN';
CREATE CONCEPT ForestBlock ( VARIABLES ( bId: STRING, treeAge: INT, speciesFactor: DECIMAL, co2Absorbed: DECIMAL ) );
CREATE RULE Rule_CO2_Calc SCOPE ForestBlock THEN co2Absorbed = treeAge * speciesFactor;
CREATE CONCEPT OceanSample ( VARIABLES ( locId: STRING, co2Level: DECIMAL, ph: DECIMAL ) );
CREATE RULE Rule_Acid_Calc SCOPE OceanSample THEN ph = 8.1 - (co2Level * 0.001);
CREATE CONCEPT LandStats ( VARIABLES ( region: STRING, initialArea: DECIMAL, currentArea: DECIMAL, lossRate: DECIMAL ) );
CREATE RULE Rule_Loss_Calc SCOPE LandStats THEN lossRate = (initialArea - currentArea) / initialArea;
CREATE CONCEPT Migration ( VARIABLES ( species: STRING, dist: DECIMAL, time: DECIMAL, speed: DECIMAL ) );
CREATE RULE Rule_Mig_Speed SCOPE Migration THEN speed = dist / time;
INSERT INTO Field VARIABLES (fId: 'FIELD_01', evapo: 5.5, rain: 1.2);
INSERT INTO Crop VARIABLES (name: 'Corn', seeds: 1000, germRate: 0.9, areaVal: 10);
INSERT INTO PestStatus VARIABLES (fId: 'FIELD_01', bugCount: 150, threshold: 100);
SELECT fId, SOLVE(waterNeed) FROM Field; SELECT name, SOLVE(expectedYield) FROM Crop; SELECT fId, SOLVE(needsSpray) FROM PestStatus;
-- KBMS Comprehensive Test Suite: LEGAL (FINAL)
CREATE KNOWLEDGE BASE Legal; USE Legal;
CREATE CONCEPT Contract ( VARIABLES ( cId: STRING, hasLiabilityClause: BOOL, isRisky: BOOL ) );
CREATE RULE Rule_Cont_Risk SCOPE Contract IF hasLiabilityClause = false THEN isRisky = true;
CREATE CONCEPT UserData ( VARIABLES ( uId: STRING, hasConsent: BOOL, isCompliant: BOOL ) );
CREATE RULE Rule_GDPR_Check SCOPE UserData IF hasConsent = true THEN isCompliant = true;
CREATE CONCEPT FinancialAudit ( VARIABLES ( name: STRING, incomeVal: DECIMAL, expenses: DECIMAL, auditRisk: STRING ) );
CREATE RULE Rule_Audit_High SCOPE FinancialAudit IF expenses > (incomeVal * 0.5) THEN auditRisk = 'HIGH';
CREATE CONCEPT Patent ( VARIABLES ( pId: STRING, regYear: INT, expiryYear: INT ) );
CREATE RULE Rule_IP_Expiry SCOPE Patent THEN expiryYear = regYear + 20;
CREATE CONCEPT ShipmentTrade ( VARIABLES ( item: STRING, amountValue: DECIMAL, tariffRate: DECIMAL, duty: DECIMAL ) );
CREATE RULE Rule_Duty_Calc SCOPE ShipmentTrade THEN duty = amountValue * tariffRate;
CREATE CONCEPT BankTransfer ( VARIABLES ( txId: STRING, amountVal: DECIMAL, flagstatusVal: STRING ) );
CREATE RULE Rule_AML_Flag SCOPE BankTransfer IF amountVal > 10000 THEN flagstatusVal = 'FLAG_FOR_REVIEW';
CREATE CONCEPT WorkLog ( VARIABLES ( empId: STRING, hours: INT, isViolation: BOOL ) );
CREATE RULE Rule_Labor_Check SCOPE WorkLog IF hours > 48 THEN isViolation = true;
CREATE CONCEPT BuildingProject ( VARIABLES ( pId: STRING, height: DECIMAL, zoneLimit: DECIMAL, isCompliant: BOOL ) );
CREATE RULE Rule_Zone_Check SCOPE BuildingProject IF height <= zoneLimit THEN isCompliant = true;
CREATE CONCEPT SafetyDevice ( VARIABLES ( id: STRING, expiryYear: INT, currentYear: INT, isExpired: BOOL ) );
CREATE RULE Rule_Safe_Expiry SCOPE SafetyDevice IF expiryYear < currentYear THEN isExpired = true;
CREATE CONCEPT BusinessLicense ( VARIABLES ( id: STRING, expiryDate: INT, currentDate: INT, daysLeft: INT ) );
CREATE RULE Rule_License_Left SCOPE BusinessLicense THEN daysLeft = expiryDate - currentDate;
INSERT INTO Contract VARIABLES (cId: 'CONT_001', hasLiabilityClause: false);
INSERT INTO BankTransfer VARIABLES (txId: 'TX12345', amountVal: 15000);
INSERT INTO BuildingProject VARIABLES (pId: 'BUILD_01', height: 45, zoneLimit: 50);
SELECT cId, SOLVE(isRisky) FROM Contract; SELECT txId, SOLVE(flagstatusVal) FROM BankTransfer; SELECT pId, SOLVE(isCompliant) FROM BuildingProject;
-- KBMS Comprehensive Test Suite: GAMING (FINAL)
CREATE KNOWLEDGE BASE Gaming; USE Gaming;
CREATE CONCEPT Combat ( VARIABLES ( atk: DECIMAL, def: DECIMAL, mult: DECIMAL, damage: DECIMAL ) );
CREATE RULE Rule_Dmg_Calc SCOPE Combat THEN damage = (atk - def) * mult;
CREATE CONCEPT Hero ( VARIABLES ( name: STRING, rankLevel: INT, xpNeeded: DECIMAL ) );
CREATE RULE Rule_XP_Calc SCOPE Hero THEN xpNeeded = (rankLevel * rankLevel) * 100;
CREATE CONCEPT LootDrop ( VARIABLES ( luck: INT, baseRarity: INT, finalRarity: DECIMAL ) );
CREATE RULE Rule_Loot_Luck SCOPE LootDrop THEN finalRarity = baseRarity + (luck * 0.5);
CREATE CONCEPT GameEconomy ( VARIABLES ( totalGold: DECIMAL, basePrice: DECIMAL, currentPrice: DECIMAL ) );
CREATE RULE Rule_Price_Inflat SCOPE GameEconomy THEN currentPrice = basePrice * (1 + (totalGold / 1000000));
CREATE CONCEPT Quest ( VARIABLES ( qId: STRING, itemGot: BOOL, bossDead: BOOL, isComplete: BOOL ) );
CREATE RULE Rule_Quest_Check SCOPE Quest IF itemGot = true AND bossDead = true THEN isComplete = true;
CREATE CONCEPT Node ( VARIABLES ( id: STRING, isWalkable: BOOL, cost: INT ) );
CREATE CONCEPT Squad ( VARIABLES ( mageCount: INT, bonus: DECIMAL ) );
CREATE RULE Rule_Syn_Mage SCOPE Squad THEN bonus = mageCount * 5;
CREATE CONCEPT Crafting ( VARIABLES ( iron: INT, wood: INT, craftResult: STRING ) );
CREATE RULE Rule_Craft_Sword SCOPE Crafting IF iron >= 2 AND wood >= 1 THEN craftResult = 'Iron Sword';
CREATE CONCEPT Weather ( VARIABLES ( humid: DECIMAL, press: DECIMAL, rainChance: DECIMAL ) );
CREATE RULE Rule_Rain_Calc SCOPE Weather THEN rainChance = humid * press;
CREATE CONCEPT NPC ( VARIABLES ( name: STRING, healthPerc: DECIMAL, action: STRING ) );
CREATE RULE Rule_AI_Retreat SCOPE NPC IF healthPerc < 20 THEN action = 'RETREAT';
INSERT INTO Hero VARIABLES (name: 'Aragon', rankLevel: 10);
INSERT INTO Quest VARIABLES (qId: 'Q001', itemGot: true, bossDead: true);
INSERT INTO Crafting VARIABLES (iron: 5, wood: 2);
INSERT INTO NPC VARIABLES (name: 'Guard', healthPerc: 15);
SELECT name, SOLVE(xpNeeded) FROM Hero; SELECT qId, SOLVE(isComplete) FROM Quest; SELECT iron, SOLVE(craftResult) FROM Crafting; SELECT name, SOLVE(action) FROM NPC;
