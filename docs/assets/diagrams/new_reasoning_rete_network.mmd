graph TD
    classDef memory fill:#2d3436,stroke:#74b9ff,stroke-width:2px,color:#dfe6e9
    classDef node fill:#0984e3,stroke:#74b9ff,stroke-width:2px,color:white
    classDef terminal fill:#d63031,stroke:#fab1a0,stroke-width:2px,color:white
    classDef agenda fill:#e17055,stroke:#ffeaa7,stroke-width:2px,color:white

    WM[/"Working Memory\n(Chứa Facts)"/]:::memory
    Root(("Entry Node")):::node
    
    A1{"Alpha Node\n(Lọc điều kiện 1)"}:::node
    A2{"Alpha Node\n(Lọc điều kiện 2)"}:::node
    
    B1["Beta Node\n(Join Left & Right)"]:::node
    B2["Beta Node\n(Join phức tạp)"]:::node
    
    T1(("Terminal Node\n(Luật 1)")):::terminal
    T2(("Terminal Node\n(Luật 2)")):::terminal
    
    Agenda[/"Agenda\n(Hàng đợi ưu tiên)"/]:::agenda
    Inference["Inference Engine\n(Thực thi kết luận)"]:::node

    WM --"AssertFact()"--> Root
    Root --> A1
    Root --> A2
    
    A1 --"Token (Fact 1)"--> B1
    A2 --"Token (Fact 2)"--> B1
    
    B1 --"Token kết hợp"--> B2
    A1 --"Token nhánh"--> B2
    
    B1 --"Khớp toàn bộ"--> T1
    B2 --"Khớp toàn bộ"--> T2
    
    T1 --"Sinh Activation"--> Agenda
    T2 --"Sinh Activation"--> Agenda
    
    Agenda --"Pop (Priority/Cost)"--> Inference
    Inference --"Tạo Fact mới\n(Forward Closure)"--> WM
