sequenceDiagram
    participant App as kbms-studio (Client)
    participant Net as KBMS.Network (TCP)
    participant Parser as KBMS.Parser (AST)
    participant Reason as KBMS.Reasoning (Inference)
    participant Store as KBMS.Storage (BufferPool)

    App->>Net: Gửi lệnh KQL/KML (Binary)
    Net->>Parser: Chuyển dữ liệu Text/Byte
    Parser->>Parser: Parser.cs: Sinh cây AST
    
    alt Lỗi Tokenizer / Cú pháp
        Parser-->>App: Trả về ParserException
    else Cú pháp hợp lệ
        Parser->>Reason: Đẩy node AST xử lý
        
        opt Nếu là lệnh INSERT/CREATE
            Reason->>Store: Yêu cầu ghi log qua WalManagerV3
            Store-->>Reason: Xác nhận Append-only Log
            Reason->>Store: BufferPoolManager.InsertTuple()
        end
        
        Reason->>Reason: Rete Network kích hoạt Rule
        
        loop Cho đến khi hết luật (F-Closure)
            Reason->>Reason: Thực thi Forward Chaining
            Reason->>Store: Ghi Fact mới sinh ra đĩa
        end
        
        Reason-->>Net: Đóng gói kết quả (ModelBinaryUtility)
        Net-->>App: Phản hồi gói tin TCP
    end
