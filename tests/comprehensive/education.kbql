-- KBMS Comprehensive Test Suite: EDUCATION (FINAL)
CREATE KNOWLEDGE BASE Education; USE Education;
CREATE CONCEPT StudentGrade ( VARIABLES ( sId: STRING, math: DECIMAL, eng: DECIMAL, sci: DECIMAL, gpa: DECIMAL ) );
CREATE RULE Rule_GPA_Avg SCOPE StudentGrade THEN gpa = (math + eng + sci) / 3;
CREATE CONCEPT Profile ( VARIABLES ( name: STRING, degree: STRING, skill: STRING, recommendation: STRING ) );
CREATE RULE Rule_Career_Dev SCOPE Profile IF degree = 'CS' AND skill = 'Python' THEN recommendation = 'Software Engineer';
CREATE CONCEPT Employee ( VARIABLES ( name: STRING, gross: DECIMAL, taxRate: DECIMAL, net: DECIMAL ) );
CREATE RULE Rule_Pay_Net SCOPE Employee THEN net = gross * (1 - taxRate);
CREATE CONCEPT Attendance ( VARIABLES ( sId: STRING, totalDays: INT, presentDays: INT, perc: DECIMAL ) );
CREATE RULE Rule_Att_Perc SCOPE Attendance THEN perc = (presentDays / totalDays) * 100;
CREATE CONCEPT Scholarship ( VARIABLES ( sId: STRING, gpa: DECIMAL, incomeVal: DECIMAL, isEligible: BOOL ) );
CREATE RULE Rule_Schol_Check SCOPE Scholarship IF gpa > 3.8 AND incomeVal < 20000 THEN isEligible = true;
CREATE CONCEPT SkillGap ( VARIABLES ( name: STRING, required: INT, actual: INT, gap: INT ) );
CREATE RULE Rule_Gap_Calc SCOPE SkillGap THEN gap = required - actual;
CREATE CONCEPT Teacher ( VARIABLES ( name: STRING, class1Hours: INT, class2Hours: INT, totalHours: INT ) );
CREATE RULE Rule_Work_Sum SCOPE Teacher THEN totalHours = class1Hours + class2Hours;
CREATE CONCEPT Course ( VARIABLES ( cId: STRING, modules: INT, completed: INT, progress: DECIMAL ) );
CREATE RULE Rule_Course_Prog SCOPE Course THEN progress = (completed / modules) * 100;
CREATE CONCEPT HRStats ( VARIABLES ( periodYear: INT, departures: INT, totalEmp: INT, turnoverRate: DECIMAL ) );
CREATE RULE Rule_Turnover_Calc SCOPE HRStats THEN turnoverRate = (departures / totalEmp) * 100;
CREATE CONCEPT Funnel ( VARIABLES ( stage: STRING, applicants: INT, passed: INT, convRate: DECIMAL ) );
CREATE RULE Rule_Conv_Calc SCOPE Funnel THEN convRate = (passed / applicants) * 100;
INSERT INTO StudentGrade VARIABLES (sId: 'STU01', math: 4.0, eng: 3.5, sci: 3.8);
INSERT INTO Profile VARIABLES (name: 'Alice', degree: 'CS', skill: 'Python');
INSERT INTO Attendance VARIABLES (sId: 'STU01', totalDays: 100, presentDays: 95);
SELECT sId, SOLVE(gpa) FROM StudentGrade; SELECT name, SOLVE(recommendation) FROM Profile; SELECT sId, SOLVE(perc) FROM Attendance;
